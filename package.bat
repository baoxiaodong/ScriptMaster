@echo off
chcp 65001 >nul 2>&1
title AI分镜工坊 - 分发包制作

echo ========================================================
echo    AI分镜工坊 - 分发包制作工具
echo ========================================================
echo.

:: ── 检查打包是否已完成 ──────────────────────────────────
if not exist "dist\AI分镜工坊\AI分镜工坊.exe" (
    echo ❌ 未找到打包结果，请先运行 build.bat
    pause
    exit /b 1
)

:: ── 复制使用说明到输出目录 ──────────────────────────────
echo 📋 复制使用说明...
copy /Y "dist_readme\使用说明.txt" "dist\AI分镜工坊\使用说明.txt" >nul 2>&1

:: ── 统计文件大小 ────────────────────────────────────────
for /f %%A in ('dir /s "dist\AI分镜工坊" ^| findstr "File(s)"') do set SIZE=%%A

echo.
echo ========================================================
echo    ✅ 分发包准备完成！
echo.
echo    位置: dist\AI分镜工坊\
echo    包含: AI分镜工坊.exe + _internal + 使用说明.txt
echo.
echo    交付方式:
echo    1. 将整个 "AI分镜工坊" 文件夹压缩为 ZIP
echo    2. 发送给用户解压即可使用
echo ========================================================
echo.
pause
